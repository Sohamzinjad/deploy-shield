# Copy this file to .env and replace the secret placeholder values before starting.
POSTGRES_DB=deployshield
POSTGRES_USER=deployshield
POSTGRES_PASSWORD=change-this-database-password
# Optional: override the local Postgres connection with a managed PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-jwt-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
# Primary credentials for the admin dashboard. These are the only credentials
# for administrative access and must be set to strong, unique values before any real deployment.
ADMIN_USER=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password
FRONTEND_ORIGIN=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:8081
